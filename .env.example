MONGODB_URI=mongodb://0.0.0.0:27017/blog
# MongoDB connection pool size, filled from server start (default 10). Raise it if requests queue for a connection under load.
# MONGODB_POOL_SIZE=10

# openssl rand -base64 32
AUTH_SECRET=replace-with-your-own-generated-secret

# Required for `next start` outside Vercel/Cloudflare: Auth.js rejects every session request
# with UntrustedHost unless the canonical URL is set (or AUTH_TRUST_HOST=true behind a trusted proxy).
AUTH_URL=http://localhost:5000

# Public origin used for metadataBase, sitemap/robots/RSS links, OG images and the CSP's
# upgrade-insecure-requests. Read at runtime (one built image works in every environment).
SITE_URL=http://localhost:5000

# Max requests per IP per window on the public view-count endpoint. Both optional --
# unset falls back to 20 and 60 respectively.
VIEW_RATE_LIMIT_POINTS=20
VIEW_RATE_LIMIT_DURATION_SECONDS=60

# Web Push (VAPID) -- generate your own keys, do not reuse another deployment's:
#   npx web-push generate-vapid-keys
# Read at runtime and handed to the browser by the server.
VAPID_PUBLIC_KEY=replace-with-your-own-generated-public-key
VAPID_PRIVATE_KEY=replace-with-your-own-generated-private-key
VAPID_CONTACT_EMAIL=mailto:you@example.com

# Who runs the site, shown on /about, /contact, /terms and /privacy; the operator is also the grievance officer
# India's IT Rules require. Unset, the pages say "the site's operator" and Contact says the address isn't set up.
# OPERATOR_NAME="Your Name"
# OPERATOR_LOCATION="Thane, Maharashtra, India"
# CONTACT_EMAIL=contact@example.com

# Feature switches, read at runtime (true unless set to false, 0, off or no). SIGNUP_ENABLED=false closes
# /auth/register; COMMENTS_ENABLED=false hides comments on posts and refuses new ones and edits.
SIGNUP_ENABLED=true
COMMENTS_ENABLED=true

# Client IP for rate limiting. Proxies append to X-Forwarded-For, so the client is TRUSTED_PROXY_HOPS
# entries from the right (1 = one proxy such as Caddy or nginx). Behind Cloudflare, set
# CLIENT_IP_HEADER=cf-connecting-ip instead. Without any proxy, client IPs can be spoofed.
TRUSTED_PROXY_HOPS=1
# CLIENT_IP_HEADER=cf-connecting-ip

# Logging: JSON lines in production, readable in development. LOG_LEVEL = debug | info | warn | error
# (default info in production, debug otherwise); LOG_FORMAT=json forces JSON in development.
# LOG_LEVEL=info

# Directory for uploaded images, served at /uploads/... (default ./uploads; /app/uploads in Docker).
# UPLOAD_DIR=/var/lib/vedev-blog/uploads

# Upload limits (post images and profile photos). 0 turns the daily and storage limits off.
UPLOAD_MAX_FILE_MB=5
UPLOAD_DAILY_LIMIT=50
UPLOAD_STORAGE_LIMIT_MB=500
UPLOAD_RATE_LIMIT_PER_HOUR=30

# IP geolocation for the addresses admins see on requests to publish: the offline DB-IP City Lite
# database, downloaded with `npm run geoip:download` (refresh monthly). Unset or missing, locations are off.
# GEOIP_DB_PATH=data/geoip/dbip-city-lite.mmdb

# Email (SMTP) for account verification and password reset. Setting SMTP_HOST turns both on: new
# accounts must confirm their email before logging in. Unset, accounts start verified and reset is off.
# Locally, Mailpit catches everything: `docker compose --profile mail up -d mailpit`, inbox at http://localhost:8025.
# SMTP_PORT defaults to 587 (STARTTLS); 465 implies SMTP_SECURE=true. Inside Compose, Mailpit is SMTP_HOST=mailpit.
# SMTP_HOST=127.0.0.1
# SMTP_PORT=1025
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM="Vedev.Guru <no-reply@example.com>"

# Read notifications are deleted this many days after being read (default 90). 0 keeps them forever;
# unread ones never expire. A change takes effect on the next server start.
# NOTIFICATION_READ_TTL_DAYS=90
